DATABASE_URL=postgresql://marketingbus:local-development-only@127.0.0.1:55438/marketingbus
APP_ORIGIN=http://127.0.0.1:3000
# Recovery deployments only: true blocks all web traffic and every worker lane.
# Any configured value except exact false quarantines. Restart all replicas to apply.
# This does not stop old replicas, migrations, CLI tools or in-flight external work.
RECOVERY_QUARANTINE=false
# Required outside local development; use a randomly generated 32+ character secret.
PILOT_INVITE_CODE=
# Keep false until an operator verifies provider/rate/worker/balance configuration.
PAID_EXECUTION_ENABLED=false
# Micro-USD; 1,000,000 = $1. No default spending allowance.
DAILY_SUPPLIER_BUDGET_MICROS=0
# Lifetime authorization: never resets at midnight or when customer data is deleted.
TOTAL_SUPPLIER_BUDGET_MICROS=0
# JSON array; see docs/PRODUCTION-OPERATIONS.md. No assumed prices or model aliases.
REASONING_RATE_CARD_JSON=[]
# Optional Claude support uses the same scoped brand/skill context. No automatic retry/fallback.
# Enable ["openai","anthropic"] only after key, verified rates and live acceptance.
REASONING_PROVIDERS_JSON=["openai"]
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=
# Prefer OpenAI for the requested Brand Engine static workflow. Optional Gemini is
# explicitly selected, never an automatic fallback. With this unset, a single-provider
# rate card is accepted for compatibility; mixed-provider cards require a choice.
IMAGE_PROVIDER=openai
# Image workflow reads only this verified rate card, never an unpriced model alias.
# Each entry: model, lane (creative/revision), inputUsdPerMillion, outputUsdPerMillion,
# maxOutputTokens (2048–32768), verifiedUntil (ISO timestamp). Use the highest applicable
# input/output modality rate including image/thinking usage. Empty disables image production.
# OpenAI: supported gpt-image-2.5-sunburst/flare model (or 2026-09-08 snapshot),
# explicit quality, textInputUsdPerMillion plus inputUsdPerMillion for IMAGE input.
# Output is one 2048x2048 WebP; verify token ceilings for this exact size/quality.
# GPT-6 Astra belongs in the creative reasoning rate card, NOT the image model field.
# Direct Images API has no input-cache discount. Missing usage is reconciled, not estimated.
IMAGE_RATE_CARD_JSON=[]
# Explicit local-render gate, separate from paid AI. Requires installed FFmpeg with libx264.
# Paths must be absolute operator-managed binaries; no automatic download or install.
MOTION_RENDERING_ENABLED=false
# Licensed instrumental uploads only. Requires matching web/worker, PCM+AAC encoders and decoder isolation review.
AUDIO_PROCESSING_ENABLED=false
MOTION_RENDER_DAILY_LIMIT=0
FFMPEG_PATH=
FFPROBE_PATH=
# Complete API key copied from open.higgsfield.ai, pasted unchanged.
# Set HIGGSFIELD_API_KEY privately on BOTH web and worker; never NEXT_PUBLIC_*.
# HF_CREDENTIALS or HF_API_KEY are equivalent aliases; use only one format.
HF_CREDENTIALS=
HF_API_KEY=
HIGGSFIELD_API_KEY=
# Legacy split-key installations only. Leave blank with a complete copied key.
# If multiple formats are populated, they must identify the same credential.
HIGGSFIELD_API_SECRET=
# Explicit operator activation; leave false until budget, account, media hosts,
# renderer isolation and designated live output tests are authorized and verified.
HIGGSFIELD_VIDEO_ENABLED=false
# Required for delivery; authenticated quote is provisional, not a final invoice.
HIGGSFIELD_EXPENSE_POLICY=
HIGGSFIELD_VERIFIED_UNTIL=
# Exact verified public CDN hostnames, never URLs, IPs or wildcard domains.
HIGGSFIELD_OUTPUT_HOSTS_JSON=[]
# Fixed-duration generated-shot rates. Empty disables quoting; keys alone do not enable a transport.
# Each entry: provider, accountId, adapterVersion, model, durationMs (1000–8000),
# ceilingMicros (all-in maximum), verifiedUntil, expensePolicy (default final).
# Higgsfield account-quote-v1 requires its matching adapter version and policy.
# See docs/VIDEO-DELIVERY-ACCOUNTING.md. No placeholder price/model is enabled.
VIDEO_RATE_CARD_JSON=[]
FIRECRAWL_API_KEY=
# Self-hosted website intake. Keep disabled until private services AND scraper egress isolation are verified.
WEBSITE_EXTRACTION_ENABLED=false
# Publishing requires installed official adapters as well as this explicit worker gate.
SOCIAL_EXECUTION_ENABLED=false
# LinkedIn company-page connection only. Publishing remains separately disabled.
# Enable only after approved app permissions and designated-account verification.
LINKEDIN_CONNECTIONS_ENABLED=false
# Text-only company publishing + verified per-post organic metrics; separate live acceptance required.
LINKEDIN_PUBLISHING_ENABLED=false
# Single approved PNG export, privately transferred. Verify a designated test post first.
LINKEDIN_IMAGE_PUBLISHING_ENABLED=false
# Approved 3–30 second final MP4 exports, multipart private upload; independent live acceptance.
LINKEDIN_VIDEO_PUBLISHING_ENABLED=false
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Explicit supported YYYYMM API version and UTC verification expiry (at most 90 days).
LINKEDIN_API_VERSION=
LINKEDIN_API_VERIFIED_UNTIL=
# Meta uses Facebook Login for Facebook Pages and linked Instagram professional accounts.
FACEBOOK_CONNECTIONS_ENABLED=false
# Facebook Page text and separately gated single-image posts. Insights remains unavailable.
FACEBOOK_PUBLISHING_ENABLED=false
FACEBOOK_IMAGE_PUBLISHING_ENABLED=false
# Approved private MP4 upload and verified Reel receipts; enable only after live-account acceptance.
FACEBOOK_REELS_ENABLED=false
INSTAGRAM_CONNECTIONS_ENABLED=false
# Single square/portrait approved image; requires matching public HTTPS APP_ORIGIN on web + worker.
# Leave off until designated-account acceptance, delivery/log safeguards and Meta permissions pass.
INSTAGRAM_PUBLISHING_ENABLED=false
INSTAGRAM_REELS_ENABLED=false
INSTAGRAM_METRICS_ENABLED=false
# Independent Reel lifetime views/reach/interactions acceptance; does not activate feed-image metrics.
INSTAGRAM_REELS_METRICS_ENABLED=false
FACEBOOK_METRICS_ENABLED=false
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=
META_API_VERIFIED_UNTIL=
# Read-only, explicit account-data refresh. Independent of publishing and paid AI.
SOCIAL_DATA_ENABLED=false
FIRECRAWL_SELF_HOSTED_URL=
FIRECRAWL_EGRESS_RESTRICTED=false
# Resend: sender must be verified in Resend. Plain email address, not display-name syntax.
EMAIL_DELIVERY_ENABLED=false
RESEND_API_KEY=
RESEND_FROM_EMAIL=
EMAIL_DAILY_LIMIT=100
# Independent 32-byte random base64 keys. Keep old keys until ALL MFA/social/email secrets
# using them are re-encrypted or securely removed. Expiring email alone is not enough.
SECRET_ENCRYPTION_KEYS_JSON={}
SECRET_ENCRYPTION_ACTIVE_KEY=
# Private Railway bucket references; never expose these through NEXT_PUBLIC variables.
ASSET_S3_ENDPOINT=
ASSET_S3_BUCKET=
ASSET_S3_REGION=auto
ASSET_S3_ACCESS_KEY_ID=
ASSET_S3_SECRET_ACCESS_KEY=
# Server-owned offers only. Empty means nothing is on sale. Payments still require a verified adapter.
# Each offer: id, name, kind (SUBSCRIPTION or TOPUP), currency (usd), amountMinor,
# generalCredits and revisionCredits. Subscription offers are monthly. No implicit price/credit default.
BILLING_OFFERS_JSON=[]
# Each Stripe-backed offer additionally needs its immutable stripePriceId.
# Requires fixed USD monthly/one-time prices, quantity 1, no discounts/tax/proration.
# Keep disabled until test-mode lifecycle and commercial/tax policies are accepted.
BILLING_EXECUTION_ENABLED=false
STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ACCOUNT_ID=
# Cancellation at period end; subscription changes disabled.
STRIPE_PORTAL_CONFIGURATION_ID=
# Operator-only refund CLI; never enabled by adding an AI key.
STRIPE_REFUNDS_ENABLED=false
# Configure snapshot webhook API version 2024-06-20 (also pinned in the transport).
# Optional operator-only pilot allocation. Exact emails; one-time ledger keys;
# expiresAt within seven days. No automatic signup balance or supplier-budget change.
# PILOT_CREDIT_GRANTS_JSON=[{"id":"unique-pilot-grant","email":"owner@example.com","credits":100,"expiresAt":"REPLACE_WITH_ISO_DATE"}]
