{
  "name": "marketingbus",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=26 <27" },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "prisma generate && next build",
    "start": "next start --hostname 0.0.0.0",
    "worker": "tsx scripts/production-worker.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1151.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource/figtree": "5.3.0",
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "fontkit": "2.0.4",
    "ipaddr.js": "2.3.0",
    "lucide-react": "0.577.0",
    "mammoth": "1.13.0",
    "next": "16.4.0",
    "pdfjs-dist": "6.4.299",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sharp": "0.35.5",
    "stripe": "23.0.0",
    "tsx": "4.22.4",
    "zod": "4.3.6"
  },
  "overrides": {
    "mammoth": {
      "argparse": "2.0.1"
    },
    "deepmerge-ts": "8.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.58.2",
    "@types/node": "22.19.15",
    "@types/fontkit": "2.0.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "jszip": "3.10.1",
    "prisma": "6.19.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
