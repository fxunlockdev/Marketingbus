generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  passwordHash String
  emailVerifiedAt DateTime?
  authVersion Int @default(0)
  createdAt    DateTime     @default(now())
  sessions     Session[]
  memberships  Membership[]
  identityTokens IdentityToken[]
  emails EmailOutbox[]
  mfa MfaCredential?
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  authVersion Int @default(0)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  socialFlows SocialOAuthFlow[]

  @@index([userId])
  @@index([expiresAt])
}

model IdentityToken {
  id String @id
  userId String
  kind String
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, kind, createdAt])
}

model EmailOutbox {
  id String @id
  userId String
  kind String
  encryptedPayload String
  status String @default("QUEUED")
  attempts Int @default(0)
  availableAt DateTime @default(now())
  leaseUntil DateTime?
  expiresAt DateTime
  providerId String?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([status, availableAt])
}

model Organization {
  id          String       @id @default(cuid())
  name        String
  requireMfa  Boolean      @default(false)
  createdAt   DateTime     @default(now())
  memberships Membership[]
  businesses  Business[]
  wallet      Wallet?
  invitations TeamInvitation[]
  teamEvents TeamEvent[]
  billingCheckouts BillingCheckout[]
  billingSubscriptions BillingSubscription[]
  billingPayments BillingPayment[]
  billingRefunds BillingRefundOperation[]
}

model Membership {
  organizationId String
  userId         String
  role           String       @default("OWNER")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([organizationId, userId])
}

model Business {
  id                String            @id @default(cuid())
  organizationId    String
  name              String
  website           String            @default("")
  industry          String            @default("")
  offering          String            @default("")
  audience          String            @default("")
  goal              String            @default("")
  difference        String            @default("")
  proof             String            @default("")
  tone              String            @default("Clear and conversational")
  restrictions      String            @default("")
  color             String            @default("#c67139")
  designPreset      String            @default("editorial")
  channels          String[]          @default(["Instagram", "LinkedIn"])
  version           Int               @default(1)
  confirmedAt       DateTime?
  productionEnabled Boolean           @default(false)
  createdAt         DateTime          @default(now())
  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  snapshots         BrandSnapshot[]
  plans             ProductionPlan[]
  memories          Memory[]
  auditEvents       AuditEvent[]
  quotes            GenerationQuote[]
  jobs              Job[]
  assets            BrandAsset[]
  sources           KnowledgeSource[]
  brandAnalyses     BrandAnalysis[]
  imageGenerations  ImageGeneration[]
  storyboards       VideoStoryboard[]
  motionRenders     MotionRender[]
  videoClips        VideoClip[]
  videoGenerations  VideoGeneration[]
  socialConnections SocialConnection[]
  socialFlows SocialOAuthFlow[]
  publications SocialPublication[]
  compositions StaticComposition[]
  compositionExports CompositionExport[]
  experiments LearningProposal[]
  independentApproval Boolean @default(false)
  comments ReviewComment[]
  weeklyPolicy WeeklyPolicy?
  weeklyCycles WeeklyCycle[]

  @@unique([id, organizationId])
  @@index([organizationId])
}

model SocialOAuthFlow {
  id String @id
  businessId String
  organizationId String
  actorId String
  sessionId String
  provider String
  stateHash String @unique
  configurationHash String
  authentication String @default("S256")
  status String @default("PENDING")
  encryptedVerifier String?
  encryptedCandidates String?
  errorCode String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  business Business @relation(fields: [businessId, organizationId], references: [id, organizationId], onDelete: Cascade)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  @@index([businessId, sessionId, createdAt])
  @@index([expiresAt])
}

model KnowledgeSource {
  id             String @id @default(cuid())
  businessId     String
  organizationId String
  kind           String
  title          String
  sourceUrl      String @default("")
  body           String @default("")
  sha256         String @default("")
  status         String @default("PROPOSED")
  createdBy      String
  createdAt      DateTime @default(now())
  retrievedAt    DateTime?
  business       Business @relation(fields: [businessId, organizationId], references: [id, organizationId], onDelete: Cascade)
  @@index([businessId, organizationId, createdAt])
}

// Source bodies are not copied here. Hashes bind proposals to the reviewed evidence.
model BrandAnalysis {
  id String @id @default(cuid())
  businessId String
  organizationId String
  actorId String
  brandVersion Int
  sources Json
  route Json
  configurationHash String
  credits Int
  supplierCeilingMicros Int
  status String @default("OFFERED")
  expiresAt DateTime
  acceptedAt DateTime?
  submittedAt DateTime?
  leaseUntil DateTime?
  reservationId String? @unique
  providerResponseId String?
  supplierCostMicros Int?
  usage Json?
  suggestions Json?
  rejectedFields String[] @default([])
  appliedFields String[] @default([])
  errorCode String?
  createdAt DateTime @default(now())
  business Business @relation(fields: [businessId, organizationId], references: [id, organizationId], onDelete: Cascade)
  @@index([businessId, organizationId, createdAt])
  @@index([status, leaseUntil])
}

model BrandSnapshot {
  id             String   @id @default(cuid())
  businessId     String
  organizationId String
  version        Int
  data           Json
  createdAt      DateTime @default(now())
  business       Business @relation(fields: [businessId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([businessId, version])
}

model ImageGeneration {
  id String @id @default(cuid())
  businessId String
  organizationId String
  actorId String
  itemId String
  revisionId String
  brandVersion Int
  version Int
  parentId String?
  feedback String @default("")
  prompt String
  references Json
  route Json
  configurationHash String
  credits Int
  supplierCeilingMicros Int
  status String @default("OFFERED")
  expiresAt DateTime
  acceptedAt DateTime?
  submittedAt DateTime?
  leaseUntil DateTime?
  reservationId String? @unique
  providerResponseId String?
  supplierCostMicros Int?
  usage Json?
  errorCode String?
  approvedBy String?
  createdAt DateTime @default(now())
  output BrandAsset?
  item ProductionItem @relation(fields: [itemId, organizationId], references: [id, organizationId], onDelete: Restrict, map: "ImageGeneration_item_scope_fkey")
  business Business @relation(fields: [businessId, organizationId], references: [id, organizationId], onDelete: Cascade)
  @@unique([id, businessId, organizationId])
  @@unique([itemId, version])
  @@index([businessId, organizationId, createdAt])
  @@index([status, leaseUntil])
}

model ProductionPlan {
  id             String           @id @default(cuid())
  businessId     String
  organizationId String
  brandVersion   Int
  title          String
  status         String           @default("PROPOSED")
  creditCeiling  Int
  createdAt      DateTime         @default(now())
  business       Business         @relation(fields: [businessId, organizationId], references: [id, organizationId], onDelete: Cascade)
  items          ProductionItem[]

  @@unique([id, organizationId])
}

model ProductionItem {
  id             String             @id @default(cuid())
  planId         String
  organizationId String
  title          String
  format         String
  channel        String
  brief          Json
  status         String             @default("PLANNED")
  scheduledFor   DateTime?
  plan           ProductionPlan     @relation(fields: [planId, organizationId], references: [id, organizationId], onDelete: Cascade)
  revisions      CreativeRevision[]
  quotes         GenerationQuote[]
  schedule       CalendarEntry?
  images         ImageGeneration[]
  storyboards    VideoStoryboard[]

  @@unique([id, organizationId])
}

model CreativeRevision {
  id             String          @id @default(cuid())
  itemId         String
  organizationId String
  version        Int
  content        Json
  status         String          @default("DRAFT")
  feedback       String          @default("")
  provenance     Json?
  createdAt      DateTime        @default(now())
  item           ProductionItem  @relation(fields: [itemId, organizationId], references: [id, organizationId], onDelete: Cascade)
  schedules      CalendarEntry[]
  publications SocialPublication[]
  authorId String?
  approvedBy String?
  approvedAt DateTime?
  comments ReviewComment[]

  @@unique([itemId, version])
  @@unique([id, organizationId])
}

model GenerationQuote {
  id                    String         @id @default(cuid())
  organizationId        String
  businessId            String
  itemId                String
  brandVersion          Int
  baseVersion           Int
  mode                  String
  credits               Int
  supplierCeilingMicros Int
  request               Json
  configurationHash     String
  status                String         @default("OFFERED")
  expiresAt             DateTime
  acceptedAt            DateTime?
  createdAt             DateTime       @default(now())
  business              Business       @relation(fields: [businessId, organizationId], references: [id, organizationId], onDelete: Cascade)
  item                  ProductionItem @relation(fields: [itemId, organizationId], references: [id, organizationId], onDelete: Cascade)
  job                   Job?

  @@unique([id, organizationId])
  @@index([organizationId, createdAt])
  @@index([acceptedAt, status])
}

model CalendarEntry {
  id             String           @id @default(cuid())
  version        Int              @default(1)
  organizationId String
  itemId         String           @unique
  revisionId     String
  scheduledFor   DateTime
  timezone       String
  status         String           @default("PLANNED")
  createdAt      DateTime         @default(now())
  item           ProductionItem   @relation(fields: [itemId, organizationId], references: [id, organizationId], onDelete: Cascade)
  revision       CreativeRevision @relation(fields: [revisionId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([itemId, organizationId])
  @@index([organizationId, scheduledFor])
  @@index([organizationId, scheduledFor, id])
}

model Memory {
  id             String   @id @default(cuid())
  organizationId String
  businessId     String
  text           String
  kind           String   @default("EXPLICIT_PREFERENCE")
  createdAt      DateTime @default(now())
  business       Business @relation(fields: [businessId, organizationId], references: [id, organizationId], onDelete: Cascade)
}

model AuditEvent {
  id             String   @id @default(cuid())
  organizationId String
  businessId     String
  actorId        String
  action         String
  detail         String
  createdAt      DateTime @default(now())
  business       Business @relation(fields: [businessId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@index([businessId, createdAt])
}

model Wallet {
  organizationId String        @id
  available      Int           @default(0)
  held           Int           @default(0)
  revisionAvailable Int @default(0)
  debt Int @default(0)
  revisionDebt Int @default(0)
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entries        CreditEntry[]
  reservations   Reservation[]
}

model CreditEntry {
  id             String   @id @default(cuid())
  organizationId String
  key            String   @unique
  kind           String
  amount         Int
  createdAt      DateTime @default(now())
  wallet         Wallet   @relation(fields: [organizationId], references: [organizationId], onDelete: Cascade)
}

model Reservation {
  id             String   @id @default(cuid())
  organizationId String
  key            String   @unique
  credits        Int
  revisionCredits Int @default(0)
  purpose String @default("INITIAL")
  state          String   @default("HELD")
  createdAt      DateTime @default(now())
  wallet         Wallet   @relation(fields: [organizationId], references: [organizationId], onDelete: Cascade)
  jobs           Job[]

  @@unique([id, organizationId])
}

model Job {
  id             String           @id @default(cuid())
  organizationId String
  businessId     String
  key            String           @unique
  kind           String
  status         String           @default("QUEUED")
  payload        Json
  attempts       Int              @default(0)
  maxAttempts    Int              @default(2)
  availableAt    DateTime         @default(now())
  leaseUntil     DateTime?
  providerTaskId String?
  submittedAt    DateTime?
  quoteId        String?          @unique
  reservationId  String?          @unique
  result         Json?
  errorCode      String?
  quote          GenerationQuote? @relation(fields: [quoteId, organizationId], references: [id, organizationId], onDelete: Cascade)
  business       Business         @relation(fields: [businessId, organizationId], references: [id, organizationId], onDelete: Cascade, map: "job_business_scope")
  reservation    Reservation?     @relation(fields: [reservationId, organizationId], references: [id, organizationId], onDelete: Cascade)
  createdAt      DateTime         @default(now())

  @@unique([quoteId, organizationId])
  @@index([status, availableAt])
}

model RateLimit {
  key       String   @id
  count     Int      @default(1)
  expiresAt DateTime
}

model BrandAsset {
  id             String   @id @default(cuid())
  organizationId String
  businessId     String
  objectKey      String   @unique
  label          String
  purpose        String
  sha256         String
  bytes          Int
  width          Int
  height         Int
  status         String   @default("PENDING")
  uploadedBy     String
  rightsConfirmedAt DateTime
  createdAt      DateTime @default(now())
  approvedForGeneration Boolean @default(false)
  archivedAt     DateTime?
  archivedFromStatus String?
  purgeAfter     DateTime?
  purgeLeaseUntil DateTime?
  generationId String? @unique
  generation ImageGeneration? @relation(fields: [generationId, businessId, organizationId], references: [id, businessId, organizationId], onDelete: Restrict)
  business       Business @relation(fields: [businessId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([businessId, organizationId, status])
  @@index([status, purgeAfter, purgeLeaseUntil])
  @@unique([generationId, businessId, organizationId])
}

// Infrastructure metadata, never customer content or secrets.
model WorkerHeartbeat {
  id                String   @id
  runtimeVersion    String
  configurationHash String
  executionEnabled  Boolean
  motionReady       Boolean @default(false)
  lastSeenAt        DateTime @default(now())

  @@index([lastSeenAt])
}

model VideoStoryboard {
  id String @id @default(cuid())
  businessId String
  organizationId String
  itemId String
  copyRevisionId String?
  brandVersion Int
  version Int
  document Json
  shotApprovals Json
  authorId String
  status String @default("DRAFT")
  approvedBy String?
  createdAt DateTime @default(now())
  business Business @relation(fields: [businessId, organizationId], references: [id, organizationId], onDelete: Cascade)
  item ProductionItem @relation(fields: [itemId, organizationId], references: [id, organizationId], onDelete: Restrict)
  renders MotionRender[]
  @@unique([itemId, version])
  @@unique([id, businessId, organizationId])
  @@index([businessId, organizationId, createdAt])
}

model VideoClip {
  id String @id @default(cuid())
  businessId String
  organizationId String
  brandVersion Int
  label String
  createdBy String
  rightsConfirmedAt DateTime
  status String @default("UPLOADING")
  sourceKey String @unique
  sourceHash String
  sourceBytes Int
  objectKey String @unique
  sha256 String @default("")
  bytes Int @default(0)
  durationMs Int @default(0)
  processorVersion String
  approvedBy String?
  leaseUntil DateTime?
  errorCode String?
  purgeAfter DateTime
  createdAt DateTime @default(now())
  generationId String? @unique
  generation VideoGeneration? @relation(fields: [generationId, businessId, organizationId], references: [id, businessId, organizationId], onDelete: Restrict)
  business Business @relation(fields: [businessId, organizationId], references: [id, organizationId], onDelete: Restrict)
  @@unique([generationId, businessId, organizationId])
  @@index([businessId, organizationId, createdAt])
  @@index([status, leaseUntil])
}

model VideoGeneration {
  id String @id @default(cuid())
  businessId String
  organizationId String
  actorId String
  storyboardId String
  itemId String
  copyRevisionId String?
  brandVersion Int
  shotId String
  shotLabel String
  documentHash String
  prompt String
  route Json
  configurationHash String
  durationMs Int
  status String @default("OFFERED")
  credits Int
  supplierCeilingMicros Int
  supplierCostMicros Int?
  reservationId String? @unique
  providerJobId String?
  providerJobKey String? @unique
  settledAt DateTime?
  receipt Json?
  pollCount Int @default(0)
  nextPollAt DateTime?
  leaseUntil DateTime?
  expiresAt DateTime
  acceptedAt DateTime?
  submittedAt DateTime?
  errorCode String?
  createdAt DateTime @default(now())
  business Business @relation(fields: [businessId, organizationId], references: [id, organizationId], onDelete: Restrict)
  output VideoClip?
  @@unique([id, businessId, organizationId])
  @@index([businessId, organizationId, createdAt])
  @@index([status, nextPollAt, leaseUntil])
}

model MotionRender {
  id String @id @default(cuid())
  businessId String
  organizationId String
  storyboardId String
  rendererVersion String
  documentHash String
  objectKey String @unique
  status String @default("QUEUED")
  bytes Int
  sha256 String @default("")
  durationMs Int
  createdBy String
  approvedBy String?
  errorCode String?
  leaseUntil DateTime?
  purgeAfter DateTime
  createdAt DateTime @default(now())
  business Business @relation(fields: [businessId, organizationId], references: [id, organizationId], onDelete: Restrict)
  storyboard VideoStoryboard @relation(fields: [storyboardId, businessId, organizationId], references: [id, businessId, organizationId], onDelete: Restrict)
  @@unique([storyboardId, rendererVersion])
  @@index([businessId, organizationId, createdAt])
  @@index([status, leaseUntil])
}

// Separate admission ledger: deleting a tenant must not reset CPU authorization.
model MotionAuthorization {
  key String @id
  createdAt DateTime @default(now())
}

// Deliberately not cascade-linked to customer records: deletion must not reset spend authority.
// Conservative lifetime reservation; no automatic replenishment after refunds or midnight.
model SupplierAuthorization {
  key          String   @id
  ceilingMicros Int
  createdAt    DateTime @default(now())
}

model SocialConnection {
  id String @id @default(cuid())
  organizationId String
  businessId String
  provider String
  externalAccountId String
  label String
  encryptedToken String
  permissions String[]
  status String @default("CONNECTED")
  expiresAt DateTime?
  dataSnapshot Json?
  dataFetchedAt DateTime?
  dataAttemptedAt DateTime?
  dataLeaseId String?
  dataLeaseUntil DateTime?
  dataErrorCode String?
  createdAt DateTime @default(now())
  business Business @relation(fields: [businessId, organizationId], references: [id, organizationId], onDelete: Cascade)
  publications SocialPublication[]
  @@unique([id, businessId, organizationId])
  @@unique([businessId, provider, externalAccountId])
  @@index([dataFetchedAt])
}

model SocialPublication {
  id String @id @default(cuid())
  organizationId String
  businessId String
  connectionId String
  revisionId String
  brandVersion Int
  payload Json
  payloadHash String
  status String @default("SCHEDULED")
  scheduledFor DateTime
  timezone String
  attempts Int @default(0)
  leaseUntil DateTime?
  externalPostId String?
  submissionAdapterVersion String?
  candidatePostId String?
  reconciliationAttempts Int @default(0)
  nextReconciliationAt DateTime?
  permalink String?
  publishedAt DateTime?
  nextMetricsAt DateTime?
  metricsLeaseUntil DateTime?
  metricsFailures Int @default(0)
  errorCode String?
  createdAt DateTime @default(now())
  business Business @relation(fields: [businessId, organizationId], references: [id, organizationId], onDelete: Cascade)
  connection SocialConnection @relation(fields: [connectionId, businessId, organizationId], references: [id, businessId, organizationId], onDelete: Restrict)
  revision CreativeRevision @relation(fields: [revisionId, organizationId], references: [id, organizationId], onDelete: Restrict)
  metrics MetricSnapshot[]
  @@unique([revisionId, connectionId])
  @@unique([connectionId, externalPostId])
  @@unique([connectionId, candidatePostId])
  @@unique([id, businessId, organizationId])
  @@index([status, scheduledFor])
  @@index([status, nextMetricsAt])
  @@index([status, nextReconciliationAt])
}

model MetricSnapshot {
  id String @id @default(cuid())
  publicationId String
  businessId String
  organizationId String
  observedAt DateTime
  definitionVersion String
  impressions Int?
  reach Int?
  engagements Int?
  clicks Int?
  videoViews Int?
  publication SocialPublication @relation(fields: [publicationId, businessId, organizationId], references: [id, businessId, organizationId], onDelete: Cascade)
  @@unique([publicationId, observedAt, definitionVersion])
  @@index([businessId, observedAt])
}

model LearningProposal {
  id String @id @default(cuid())
  businessId String
  organizationId String
  brandVersion Int
  hypothesis String
  evidence Json
  status String @default("PROPOSED")
  memoryId String?
  createdAt DateTime @default(now())
  business Business @relation(fields: [businessId, organizationId], references: [id, organizationId], onDelete: Cascade)
  @@index([businessId, createdAt])
}

model StaticComposition {
  id String @id @default(cuid())
  businessId String
  organizationId String
  itemId String
  revisionId String
  brandVersion Int
  version Int
  document Json
  status String @default("DRAFT")
  authorId String?
  approvedBy String?
  approvedRendererVersion String?
  createdAt DateTime @default(now())
  business Business @relation(fields: [businessId, organizationId], references: [id, organizationId], onDelete: Cascade)
  exports CompositionExport[]
  @@unique([id, businessId, organizationId])
  @@unique([itemId, version])
  @@index([businessId, itemId])
}

model CompositionExport {
  id String @id @default(cuid())
  businessId String
  organizationId String
  compositionId String
  placement String
  rendererVersion String
  manifest Json
  objectKey String @unique
  status String @default("STORING")
  sha256 String @default("")
  bytes Int
  leaseUntil DateTime?
  purgeAfter DateTime
  createdBy String
  createdAt DateTime @default(now())
  business Business @relation(fields: [businessId, organizationId], references: [id, organizationId], onDelete: Restrict)
  composition StaticComposition @relation(fields: [compositionId, businessId, organizationId], references: [id, businessId, organizationId], onDelete: Restrict)
  @@unique([compositionId, placement, rendererVersion])
  @@index([businessId, organizationId, createdAt])
  @@index([status, purgeAfter, leaseUntil])
}

model TeamInvitation {
  id String @id
  organizationId String
  email String
  role String
  createdBy String
  outboxId String
  status String @default("PENDING")
  expiresAt DateTime
  createdAt DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@index([organizationId, createdAt])
}

model TeamEvent {
  id String @id @default(cuid())
  organizationId String
  actorId String
  action String
  detail String
  createdAt DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@index([organizationId, createdAt])
}

model MfaCredential {
  userId String @id
  encryptedSecret String @default("")
  pendingSecret String @default("")
  pendingExpiresAt DateTime?
  enabledAt DateTime?
  lastStep Int @default(-1)
  recoveryHashes String[] @default([])
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ReviewComment {
  id String @id @default(cuid())
  businessId String
  organizationId String
  revisionId String
  actorId String
  body String
  blocking Boolean @default(false)
  resolvedBy String?
  resolvedAt DateTime?
  createdAt DateTime @default(now())
  business Business @relation(fields: [businessId, organizationId], references: [id, organizationId], onDelete: Cascade)
  revision CreativeRevision @relation(fields: [revisionId, organizationId], references: [id, organizationId], onDelete: Cascade)
  @@index([revisionId, resolvedAt])
}

model WeeklyPolicy {
  businessId String @id
  organizationId String
  enabled Boolean @default(false)
  mode String @default("PLAN")
  maxItems Int @default(4)
  creditsPerWeek Int @default(0)
  weekday Int @default(1)
  hourUTC Int @default(9)
  nextRunAt DateTime
  version Int @default(1)
  brandVersion Int
  actorId String
  business Business @relation(fields: [businessId, organizationId], references: [id, organizationId], onDelete: Cascade)
  @@index([enabled, nextRunAt])
  @@unique([businessId, organizationId])
}

model WeeklyCycle {
  id String @id @default(cuid())
  businessId String
  organizationId String
  periodKey String
  policyVersion Int
  brandVersion Int
  planId String
  status String @default("OPEN")
  creditsAuthorized Int @default(0)
  errorCode String?
  leaseUntil DateTime?
  createdAt DateTime @default(now())
  business Business @relation(fields: [businessId, organizationId], references: [id, organizationId], onDelete: Cascade)
  tasks WeeklyTask[]
  @@unique([businessId, periodKey])
  @@index([status, leaseUntil])
}

model WeeklyTask {
  id String @id @default(cuid())
  cycleId String
  itemId String
  quoteId String?
  status String @default("PENDING")
  errorCode String?
  cycle WeeklyCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  @@unique([cycleId, itemId])
}

model BillingCheckout {
  id String @id @default(cuid())
  organizationId String
  actorId String
  offer Json
  status String @default("CREATED")
  providerSessionId String? @unique
  url String?
  createdAt DateTime @default(now())
  expiresAt DateTime
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@index([organizationId, createdAt])
}
model BillingSubscription {
  id String @id
  organizationId String
  customerId String
  offer Json
  status String
  currentPeriodEnd DateTime
  updatedThrough DateTime
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  @@index([organizationId])
}
model BillingPayment {
  id String @id
  organizationId String
  checkoutId String?
  subscriptionId String?
  periodStart DateTime?
  amountMinor Int
  currency String
  generalCredits Int
  revisionCredits Int
  refundedMinor Int @default(0)
  reclaimedGeneral Int @default(0)
  reclaimedRevision Int @default(0)
  createdAt DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  refunds BillingRefundOperation[]
  @@unique([subscriptionId, periodStart])
  @@index([organizationId, createdAt])
}
// Provider references only, never card data. No cascade deletion: event replays cannot mint credits.
model BillingEvent {
  id String @id
  payload Json
  digest String
  status String @default("PENDING")
  errorCode String?
  attempts Int @default(0)
  availableAt DateTime @default(now())
  createdAt DateTime @default(now())
  reconciliations BillingReconciliation[]
  @@index([status, availableAt])
}

model BillingReconciliation {
  id String @id
  eventId String
  operatorId String
  evidence String
  createdAt DateTime @default(now())
  event BillingEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)
  @@index([eventId, createdAt])
}

// Operator-only money movement. No cascade and no customer HTTP initiation route.
model BillingRefundOperation {
  id String @id
  paymentId String
  organizationId String
  amountMinor Int
  status String @default("SUBMITTING")
  providerRefundId String? @unique
  operatorId String
  evidence String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  payment BillingPayment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  @@index([paymentId, status])
  @@index([organizationId, createdAt])
}
